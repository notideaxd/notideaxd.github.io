---
// Marcador de la fase 1: cada pantalla solo muestra su título hasta que se construya.
interface Props {
  titulo: string;
  fondoTexto: string;
}

const { titulo, fondoTexto } = Astro.props;
---

<div class="relative flex min-h-[60vh] items-center justify-center overflow-hidden px-6 py-16">
  <span
    aria-hidden="true"
    class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-titulo text-[clamp(120px,24vw,300px)] leading-[0.82] font-bold whitespace-nowrap text-white/5 select-none"
  >
    {fondoTexto}
  </span>
  <div class="relative flex flex-col items-center gap-3 text-center">
    <span class="font-titulo text-[13px] font-semibold tracking-[0.18em] text-texto-2">▸ {titulo}</span>
    <h1 class="font-titulo text-[clamp(44px,8vw,88px)] leading-none font-bold text-acento uppercase">{titulo}</h1>
    <p class="text-sm text-texto-2">[PANTALLA EN CONSTRUCCIÓN]</p>
  </div>
</div>
