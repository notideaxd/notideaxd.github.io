---
import Imagen from '../Imagen.astro';
import { obtenerPerfil, coleccionOrdenada, aRomano } from '../../lib/contenido';

const perfil = await obtenerPerfil();
const eventos = await coleccionOrdenada('historial');
const avance = Math.round((perfil.ciclo / perfil.ciclos_totales) * 100);

// Verde para hackathons, dorado para universidad.
const estilo = {
  hackathon: { fondo: 'bg-[#123A3A]', borde: 'border-positivo', texto: 'text-[#7BE8CC]', etiqueta: 'HACKATHON' },
  universidad: { fondo: 'bg-[#1A2744]', borde: 'border-dorado', texto: 'text-dorado', etiqueta: 'UNIVERSIDAD' },
} as const;

const etiquetaSeccion = 'font-titulo text-[13px] font-semibold tracking-[0.14em] text-texto-2';
const caja = 'border border-[#2A3A5C] bg-[#0C1424]';
---

<div class="grid gap-6 lg:grid-cols-[minmax(220px,1fr)_minmax(0,3fr)_minmax(200px,1fr)]">
  <!-- Jugador y sobre mí -->
  <section aria-labelledby="titulo-jugador" class="flex flex-col gap-2.5">
    <h2 id="titulo-jugador" class={etiquetaSeccion}>JUGADOR</h2>
    <div class:list={[caja, 'flex items-center gap-3 p-3']}>
      <Imagen
        carpeta="perfil"
        nombre="tarjeta"
        alt={`Foto de ${perfil.nombre}`}
        marcador="[FOTO]"
        class="h-12 w-12 shrink-0"
        claseMarcador="!p-0 [&>span]:border-0 [&>span]:bg-transparent [&>span]:px-0 [&>span]:text-[11px]"
        anchos={[48, 96]}
        sizes="48px"
        encuadre="object-top"
      />
      <div class="flex min-w-0 flex-col">
        <span class="font-titulo text-[22px] leading-tight font-bold">{perfil.nombre}</span>
        <span class="text-[13px] text-texto-2">{perfil.ciudad}</span>
      </div>
    </div>
    <div class:list={[caja, 'flex flex-col gap-1.5 px-3 py-3.5']}>
      <h3 class="font-titulo text-[15px] font-bold tracking-[0.1em]">SOBRE MÍ</h3>
      <p class="text-sm leading-relaxed text-[#D5DBE0]">{perfil.sobre_mi}</p>
    </div>
  </section>

  <!-- Historial de partidas -->
  <section aria-labelledby="titulo-historial" class="flex flex-col gap-1.5">
    <h2 id="titulo-historial" class:list={[etiquetaSeccion, 'mb-1']}>HISTORIAL DE PARTIDAS</h2>
    <ol class="flex flex-col gap-1.5">
      {
        eventos.map(({ data: e }) => {
          const s = estilo[e.categoria];
          return (
            <li class:list={['flex flex-wrap items-center gap-x-4 gap-y-2 border-l-4 px-4 py-3', s.fondo, s.borde]}>
              <span class="w-14 shrink-0 font-titulo text-2xl font-bold">{e.anio}</span>
              <div class="flex min-w-0 flex-[3_1_240px] flex-col">
                <h3 class="font-titulo text-[22px] leading-tight font-bold uppercase">{e.titulo}</h3>
                <p class="text-[13px] text-[#D5DBE0]">{e.detalle}</p>
              </div>
              <span class:list={['flex-[1_1_120px] font-titulo text-base font-bold tracking-[0.12em]', s.texto]}>{s.etiqueta}</span>
              <span class="font-titulo text-sm font-semibold tracking-[0.1em] uppercase">{e.resultado}</span>
            </li>
          );
        })
      }
      <li class="border border-dashed border-[#3A4A6C] px-4 py-3 font-titulo text-[15px] font-semibold tracking-[0.1em] text-texto-2">
        {perfil.proxima_partida}
      </li>
    </ol>
  </section>

  <!-- Rango actual -->
  <section aria-labelledby="titulo-rango" class:list={[caja, 'flex flex-col items-center justify-center gap-3.5 px-4 py-6']}>
    <h2 id="titulo-rango" class={etiquetaSeccion}>RANGO ACTUAL</h2>
    <span class="corte-hexagono flex h-[110px] w-[126px] items-center justify-center bg-texto-2" aria-hidden="true">
      <span class="corte-hexagono flex h-[102px] w-[118px] items-center justify-center bg-[#0C1424] font-titulo text-[52px] font-bold">
        {aRomano(perfil.ciclo)}
      </span>
    </span>
    <span class="font-titulo text-[30px] leading-none font-bold">CICLO {perfil.ciclo}</span>
    <div
      class="h-1 w-4/5 bg-[#2A3A5C]"
      role="progressbar"
      aria-label="Avance de la carrera"
      aria-valuemin="0"
      aria-valuemax={perfil.ciclos_totales}
      aria-valuenow={perfil.ciclo}
      aria-valuetext={`Ciclo ${perfil.ciclo} de ${perfil.ciclos_totales}`}
    >
      <div class="h-1 bg-positivo" style={`width: ${avance}%`}></div>
    </div>
    <span class="text-[13px] text-texto-2">{perfil.ciclo} de {perfil.ciclos_totales} ciclos</span>
  </section>
</div>
