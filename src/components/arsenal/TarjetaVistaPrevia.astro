---
// Vista previa compacta de la tarjeta de jugador del Inicio.
import MarcadorImagen from '../MarcadorImagen.astro';
import { obtenerPerfil } from '../../lib/contenido';

const perfil = await obtenerPerfil();
---

<section aria-labelledby="titulo-tarjeta" class="flex flex-col items-center gap-2.5">
  <h2 id="titulo-tarjeta" class="font-titulo text-xl font-bold tracking-[0.04em]">TARJETA DE JUGADOR</h2>
  <div class="corte-tarjeta h-[360px] w-[150px] bg-acento p-0.5">
    <div class="corte-tarjeta flex h-full flex-col items-center gap-2 bg-[#101820]">
      <MarcadorImagen texto="[ARTE DE TU TARJETA]" class="h-[210px] w-full shrink-0 [&>span]:text-xs" />
      <span class="font-titulo text-lg font-bold text-dorado">{perfil.nombre}</span>
      <span class="px-2 text-center text-[11px] text-texto-2">{perfil.titulo_jugador}</span>
    </div>
  </div>
  <p class="text-center text-xs leading-snug text-texto-2">Así se ve tu tarjeta en el Inicio.</p>
</section>
