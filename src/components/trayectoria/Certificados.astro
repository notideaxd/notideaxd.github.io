---
import { getCollection } from 'astro:content';
import Imagen from '../Imagen.astro';
import { nombreImagen } from '../../lib/imagenes';
import { esMarcador } from '../../lib/contenido';

const certificados = (await getCollection('certificados')).sort((a, b) => a.data.anio.localeCompare(b.data.anio));
---

<div class="flex flex-col items-center gap-7 pt-4">
  <ul class="flex max-w-[900px] flex-wrap justify-center gap-[18px]">
    {
      certificados.map(({ id, data: c }) => (
        <li class="flex w-[190px] flex-col items-center gap-2">
          <button
            type="button"
            data-abrir-certificado={id}
            aria-haspopup="dialog"
            aria-label={`Ver certificado: ${c.titulo}, ${c.institucion}`}
            class="group cursor-pointer"
          >
            <span class="corte-hexagono flex h-[150px] w-[170px] items-center justify-center bg-acento group-hover:bg-texto">
              <span class="corte-hexagono flex h-[142px] w-[162px] flex-col items-center justify-center bg-[#1A2744] font-titulo">
                <span class="text-[44px] leading-none font-bold">{c.insignia ?? c.titulo.slice(0, 2).toUpperCase()}</span>
                <span class="max-w-[110px] truncate text-xs font-semibold tracking-[0.14em] uppercase">{c.titulo}</span>
              </span>
            </span>
          </button>
          <span class="text-center font-titulo text-base font-bold tracking-[0.08em] uppercase">
            {c.titulo} · {c.institucion}
          </span>
          <span class="text-xs text-positivo">Obtenido · {c.anio}</span>
        </li>
      ))
    }
    <li class="flex w-[190px] flex-col items-center gap-2">
      <span class="corte-hexagono flex h-[150px] w-[170px] items-center justify-center bg-[#3A4A6C]">
        <span class="corte-hexagono flex h-[142px] w-[162px] items-center justify-center bg-[#14203A] text-texto-2">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="5" y="11" width="14" height="9" />
            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
          </svg>
        </span>
      </span>
      <span class="font-titulo text-base font-bold tracking-[0.08em]">POR DESBLOQUEAR</span>
      <span class="text-xs text-texto-2">Mi próxima meta</span>
    </li>
  </ul>
  <p class="max-w-[520px] text-center text-[13px] text-texto-2">Haz clic en una insignia para ver el certificado en grande.</p>

  {
    certificados.map((entrada) => {
      const { id, data: c } = entrada;
      return (
      <dialog
        data-certificado={id}
        aria-labelledby={`cert-titulo-${id}`}
        class="m-auto w-[min(720px,calc(100vw-32px))] border border-acento bg-panel p-0 text-texto"
      >
        <div class="flex flex-col gap-4 p-5">
          <div class="flex items-start justify-between gap-4">
            <div class="flex flex-col gap-1">
              <span class="font-titulo text-xs font-semibold tracking-[0.14em] text-acento">CERTIFICADO</span>
              <h2 id={`cert-titulo-${id}`} class="font-titulo text-[32px] leading-none font-bold uppercase">
                {c.titulo}
              </h2>
              <p class="text-sm text-texto-2">
                {c.institucion} · {c.anio}
              </p>
            </div>
            <button
              type="button"
              data-cerrar-certificado
              class="min-h-11 shrink-0 cursor-pointer border border-texto px-4 font-titulo text-sm font-bold tracking-[0.14em] hover:bg-panel-alto"
            >
              CERRAR
            </button>
          </div>
          <Imagen
            carpeta="certificados"
            nombre={nombreImagen(entrada)}
            alt={`Certificado de ${c.titulo}, ${c.institucion}`}
            marcador={`[IMAGEN DEL CERTIFICADO: ${c.titulo.toUpperCase()}]`}
            class="aspect-[4/3] w-full"
            anchos={[720, 1440]}
            sizes="(min-width: 760px) 680px, calc(100vw - 72px)"
            ajuste="contain"
          />
          {c.enlace && !esMarcador(c.enlace) && (
            <a
              href={c.enlace}
              target="_blank"
              rel="noopener noreferrer"
              class="self-end border border-texto bg-texto px-5 py-2.5 font-titulo text-base font-bold tracking-[0.14em] text-fondo"
            >
              VER CERTIFICADO
            </a>
          )}
        </div>
      </dialog>
      );
    })
  }
</div>
