---
import MarcadorImagen from '../MarcadorImagen.astro';
import { obtenerPerfil, dosDigitos } from '../../lib/contenido';

const perfil = await obtenerPerfil();
---

<article aria-label={`Tarjeta de jugador de ${perfil.nombre}`} class="corte-tarjeta h-[464px] w-[184px] shrink-0 bg-acento p-0.5">
  <div class="corte-tarjeta flex h-full flex-col items-center bg-[#101820]">
    <div class="bg-acento px-2.5 py-1 font-titulo text-sm font-bold tracking-[0.08em] text-fondo">
      NVL {dosDigitos(perfil.ciclo)}
    </div>
    <MarcadorImagen texto="[TU FOTO O ARTE]" class="h-[240px] w-full shrink-0" />
    <div class="w-full border-t-2 border-positivo py-1 text-center font-titulo text-[13px] font-bold tracking-[0.18em] text-positivo">
      LISTO
    </div>
    <h2 class="mt-1 font-titulo text-2xl leading-tight font-bold text-dorado">{perfil.nombre}</h2>
    <p class="px-2 text-center text-xs text-texto-2">{perfil.titulo_jugador}</p>
    <div class="mt-3.5 flex gap-[46px]" aria-hidden="true">
      <span class="h-[30px] w-3.5 skew-y-[40deg] bg-dorado"></span>
      <span class="h-[30px] w-3.5 -skew-y-[40deg] bg-dorado"></span>
    </div>
  </div>
</article>
